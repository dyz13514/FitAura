<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 日期 -->
        <TextView
            android:id="@+id/tv_workout_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2023年4月15日"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginBottom="8dp"/>

        <!-- 训练部位 -->
        <TextView
            android:id="@+id/tv_workout_body_part"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="训练部位: 胸部"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <!-- 训练强度 -->
        <TextView
            android:id="@+id/tv_workout_intensity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="训练强度: 适中"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <!-- 训练时长 -->
        <TextView
            android:id="@+id/tv_workout_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="训练时长: 45分钟"
            android:textSize="16sp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView> 
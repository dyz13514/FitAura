<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.dyzapplication.IDActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorStGreen"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <ImageView
        android:id="@+id/userlogo"
        android:layout_width="145dp"
        android:layout_height="155dp"
        android:layout_below="@+id/toolbar"
    android:layout_centerHorizontal="true"
    android:layout_marginTop="30dp"
    android:src="@drawable/head"/>


    <TextView
        android:id="@+id/textname"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_below="@+id/userlogo"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="45dp"
        android:text="姓名："
        android:textSize="20sp" />
    <EditText
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@id/userlogo"
        android:layout_marginTop="40dp"
        android:layout_toRightOf="@id/textname"
        android:layout_marginRight="40dp"
        android:id="@+id/editname"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="年龄："
        android:textSize="20sp"
        android:layout_below="@id/textname"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="40dp"
        android:id="@+id/textage"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@id/editname"
        android:layout_toRightOf="@id/textage"
        android:layout_marginTop="10dp"
        android:layout_marginRight="40dp"
        android:id="@+id/editage"
        android:inputType="number"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="性别："
        android:textSize="20sp"
        android:layout_below="@id/textage"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="40dp"
        android:id="@+id/textsex"/>
    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_below="@id/editage"
        android:layout_marginTop="15dp"
        android:layout_toRightOf="@id/textsex"
        android:id="@+id/radiosex"
        android:layout_marginRight="40dp"
        android:orientation="horizontal">
        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="男"
            android:id="@+id/idmale"
            android:textSize="20sp"/>
        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="女"
            android:id="@+id/idfemale"
            android:textSize="20sp"/>
    </RadioGroup>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="生日："
        android:textSize="20sp"
        android:layout_below="@id/textsex"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="40dp"
        android:id="@+id/textbirth"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@id/radiosex"
        android:layout_toRightOf="@id/textage"
        android:layout_marginTop="15dp"
        android:layout_marginRight="40dp"
        android:focusable="false"
        android:id="@+id/editbirth" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="兴趣爱好："
        android:textSize="20sp"
        android:layout_below="@id/textbirth"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="40dp"
        android:id="@+id/texthobby"/>

    <EditText
        android:id="@+id/edithobby"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@id/editbirth"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="40dp"
        android:focusable="false"
        android:layout_toRightOf="@id/textage" />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="确定"
        android:textSize="20sp"
        android:layout_below="@id/texthobby"
        android:layout_marginTop="40dp"
        android:layout_marginLeft="80dp"
        android:id="@+id/button_submit"/>
    <Button
        android:id="@+id/button_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/texthobby"
        android:layout_alignParentRight="true"
        android:layout_marginLeft="90dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="80dp"
        android:text="取消"
        android:textSize="20sp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:layout_below="@id/button_submit"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="40dp"
        android:id="@+id/text_output"/>

</RelativeLayout>

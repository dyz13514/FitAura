<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/userlogo"
        android:layout_width="145dp"
        android:layout_height="155dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:src="@drawable/head"/>
    <TextView
        android:id="@+id/regtext_username"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_below="@+id/userlogo"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="45dp"
        android:text="用户名："
        android:textSize="20sp" />
    <EditText
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@id/userlogo"
        android:layout_marginTop="40dp"
        android:layout_toRightOf="@id/regtext_username"
        android:layout_marginRight="40dp"
        android:id="@+id/regedit_username"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="密码："
        android:textSize="20sp"
        android:layout_below="@id/regtext_username"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="40dp"
        android:id="@+id/regtext_password"/>

    <EditText
        android:id="@+id/regedit_password"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@id/regedit_username"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="40dp"
        android:layout_toRightOf="@id/regtext_password"
        android:inputType="number" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="确认密码："
        android:textSize="20sp"
        android:layout_below="@id/regtext_password"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="40dp"
        android:id="@+id/regtext_comformpassword"/>

    <EditText
        android:id="@+id/regedit_comformpassword"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@id/regedit_password"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="40dp"
        android:layout_toRightOf="@id/regtext_comformpassword"
        android:inputType="number" />

    <Button
        android:id="@+id/regbutton_reg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/regtext_comformpassword"
        android:layout_marginLeft="80dp"
        android:layout_marginTop="40dp"
        android:text="注册"
        android:textSize="20sp" />

    <Button
        android:id="@+id/regutton_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/regtext_comformpassword"
        android:layout_alignParentRight="true"
        android:layout_marginLeft="90dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="80dp"
        android:text="取消"
        android:textSize="20sp"/>


</RelativeLayout>

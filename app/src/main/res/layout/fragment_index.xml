<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 顶部标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FitAura健身计划"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- 日期显示 -->
    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- 健身信息卡片 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:elevation="4dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            
            <TextView
                android:id="@+id/tv_body_part"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="今日训练部位: 胸部"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
                
            <TextView
                android:id="@+id/tv_workout_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="状态: 未完成"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>
                
            <Button
                android:id="@+id/btn_today_workout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开始今日训练"
                android:textAllCaps="false"
                android:padding="12dp"
                android:backgroundTint="#4CAF50"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 自定义训练按钮 -->
    <Button
        android:id="@+id/btn_custom_workout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="自定义训练"
        android:textAllCaps="false"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#2196F3"/>

    <!-- 健身小贴士卡片 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="健身小贴士"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 坚持每天锻炼，保持良好习惯\n• 注意运动前后的热身和拉伸\n• 训练时保持正确姿势，避免受伤\n• 适当休息，让肌肉有恢复时间\n• 保持充足的蛋白质摄入"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
